{
  "name": "@tkottke90/theme-tactical-react",
  "version": "0.1.0",
  "description": "Dark HUD-inspired component theme (Preact, React-API compatible) with cyan glow accents, resizable SVG panel frames (tab-and-chevron on Card/Stat, tab-notch-and-bracket on Viewfinder), and data-display components (stat readout, progress bar, radial gauge).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "jest",
    "lint": "eslint .",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build",
    "build-storybook": "storybook build",
    "screenshot": "node ../../scripts/screenshot.mjs"
  },
  "peerDependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/preact": "^8.4.0",
    "@storybook/preact-vite": "^8.4.0",
    "@tailwindcss/cli": "^4.0.0",
    "@testing-library/preact": "^3.2.0",
    "preact": "^10.24.0",
    "storybook": "^8.4.0",
    "tailwindcss": "^4.0.0"
  }
}
