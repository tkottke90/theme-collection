{
  "name": "@tkottke90/theme-starter-css",
  "version": "0.1.0",
  "description": "Starter CSS theme (Tailwind v4-based) — reference template for @tkottke90/theme-* CSS-only packages.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.css",
  "style": "./dist/index.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tailwindcss -i ./src/index.css -o ./dist/index.css --minify",
    "lint": "eslint .",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build",
    "build-storybook": "storybook build",
    "screenshot": "node ../../scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/html": "^8.4.0",
    "@storybook/html-vite": "^8.4.0",
    "@tailwindcss/cli": "^4.0.0",
    "storybook": "^8.4.0",
    "tailwindcss": "^4.0.0"
  }
}
