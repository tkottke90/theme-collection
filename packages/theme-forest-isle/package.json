{
  "name": "@tkottke90/theme-forest-isle",
  "version": "0.1.0",
  "description": "Warm, illustrated cozy-life-sim dashboard CSS theme (Tailwind v4-based) with a sage-green primary accent, parchment surfaces, and a wood-grain sidebar with selected/deselected nav links, inspired by a cottage-island dashboard design.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.css",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "rimraf dist && tailwindcss -i ./src/index.css -o ./dist/index.css --minify",
    "lint": "eslint .",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build",
    "build-storybook": "storybook build",
    "screenshot": "node ../../scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/html": "^8.4.0",
    "@storybook/html-vite": "^8.4.0",
    "@tailwindcss/cli": "^4.0.0",
    "storybook": "^8.4.0",
    "tailwindcss": "^4.0.0"
  }
}
