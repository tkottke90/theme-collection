{
  "name": "@tkottke90/theme-tactical-wc",
  "version": "0.1.0",
  "description": "Dark/light HUD-inspired Web Component theme (Lit) with cyan glow accents, resizable SVG panel frames (tab-and-chevron on Card/Stat, uneven-corner-plus-bracket on Viewfinder), and data-display components (stat readout, progress bar, radial gauge).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate-theme-styles": "node scripts/generate-theme-styles.mjs",
    "pretest": "npm run generate-theme-styles",
    "test": "jest",
    "lint": "eslint .",
    "prestorybook": "npm run generate-theme-styles",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run generate-theme-styles",
    "build-storybook": "storybook build",
    "screenshot": "node ../../scripts/screenshot.mjs"
  },
  "peerDependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/web-components": "^8.4.0",
    "@storybook/web-components-vite": "^8.4.0",
    "@tailwindcss/cli": "^4.0.0",
    "lit": "^3.2.0",
    "storybook": "^8.4.0",
    "tailwindcss": "^4.0.0"
  }
}
